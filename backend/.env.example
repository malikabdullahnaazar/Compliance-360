# SYSTEM CONFIGURATION
APP_ENV=Dev
DEBUG=True

# AI SERVICE CONFIGURATION (LangChain)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=16000

GOOGLE_API_KEY=your_google_key
GOOGLE_MODEL=gemini-2.0-pro-exp-02-05
GOOGLE_TEMPERATURE=0.1

# AI PROCESSOR SETTINGS
AI_MAX_DOCUMENT_SIZE_MB=500
AI_SUPPORTED_FORMATS=pdf,doc,docx,txt
AI_OCR_ENABLED=true

# Compliance Frameworks
DEFAULT_FRAMEWORKS=CMS,CHAP
ENABLE_TEXAS_HHSC=true
