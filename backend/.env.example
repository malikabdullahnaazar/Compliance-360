# SYSTEM CONFIGURATION
APP_ENV=Dev
DEBUG=True

# Celery / Redis (async AI analysis). Production: set REDIS_URL if not localhost.
# Examples:
#   REDIS_URL=redis://127.0.0.1:6379/0
#   REDIS_URL=redis://:yourpassword@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
# Optional override (otherwise REDIS_URL or defaults apply)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Optional task result backend (not required for AnalysisJob polling)
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# AI SERVICE CONFIGURATION (LangChain)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-5.4
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=16000

GOOGLE_API_KEY=your_google_key
GOOGLE_MODEL=gemini-2.0-pro-exp-02-05
GOOGLE_TEMPERATURE=0.1

# AI PROCESSOR SETTINGS
AI_MAX_DOCUMENT_SIZE_MB=500
AI_SUPPORTED_FORMATS=pdf,doc,docx,txt
AI_OCR_ENABLED=true

# Compliance Frameworks
DEFAULT_FRAMEWORKS=CMS,CHAP
ENABLE_TEXAS_HHSC=true
